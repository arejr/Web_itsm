# ---------- พื้นฐาน ----------
PORT=4000
NODE_ENV=development

# ---------- ฐานข้อมูล ----------
# ใช้บนเครื่อง
MONGODB_URI=mongodb://127.0.0.1:27017/itsm
# ใช้ MongoDB Atlas (ฟรี) — คัดลอก connection string มาวางแทน
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/itsm?retryWrites=true&w=majority

# ---------- ความปลอดภัย ----------
# ต้องเปลี่ยนเป็นค่าลับของตัวเองก่อนใช้งานจริง (ระบบจะไม่ยอมสตาร์ตถ้ายังเป็นค่านี้ตอน NODE_ENV=production)
# สร้างค่าสุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# โดเมนของ frontend ที่อนุญาตให้เรียก API — ใส่หลายค่าได้โดยคั่นด้วยจุลภาค
# ถ้า deploy แบบเซิร์ฟเวอร์เดียว (backend เสิร์ฟ frontend ด้วย) ให้ใส่โดเมนเดียวกันกับเว็บ
CLIENT_ORIGIN=http://localhost:5173
# CLIENT_ORIGIN=https://itsm.example.com,https://www.itsm.example.com
