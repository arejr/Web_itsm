{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: API (โหมดสาธิต)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/devServer.js",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug: API (MongoDB จริง)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/index.js",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug: Seed ข้อมูลตัวอย่าง",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/seed.js",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
