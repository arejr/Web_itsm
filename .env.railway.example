# ตัวแปรที่ต้องตั้งใน Railway → Variables ของ service ชื่อ itsm
#
# ตั้งเอง 2 ตัวนี้:
NODE_ENV=production
SEED_ON_START=true          # ใส่ข้อมูลตั้งต้นให้ครั้งแรก — เปลี่ยนเป็น false หลังใช้งานจริงแล้ว

# JWT_SECRET — สร้างค่าสุ่มด้วยคำสั่งนี้แล้วนำมาวาง
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------- ไม่ต้องตั้งเอง Railway จัดการให้ ----------
# MONGO_URL              มาจากการผูก MongoDB service เข้ากับ project
# PORT                   Railway กำหนดเอง
# RAILWAY_PUBLIC_DOMAIN  โดเมนจริงของ service — ระบบใช้เป็น CORS origin ให้อัตโนมัติ
# UPLOAD_DIR             ตั้งเป็น /data/uploads ไว้ใน Dockerfile แล้ว
